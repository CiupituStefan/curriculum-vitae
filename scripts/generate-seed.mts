/*
 * Generates supabase/seed.sql from the typed seed content (src/domain/content/seed.ts and src/domain/projects/seed.ts), so the
 * database starts with exactly the same validated content the site falls back to.
 * Usage: node --experimental-strip-types scripts/generate-seed.mts
 */
import { writeFileSync } from "node:fs";
import { seedContent } from "../src/domain/content/seed.ts";
import { seedProjects } from "../src/domain/projects/seed.ts";

const q = (value: unknown) => `'${JSON.stringify(value).replace(/'/g, "''")}'::jsonb`;
const s = (value: string) => `'${value.replace(/'/g, "''")}'`;

const lines: string[] = ["-- Generated by scripts/generate-seed.mts — do not edit by hand.", "begin;"];
for (const [key, data] of Object.entries(seedContent)) {
  lines.push(`insert into public.cv_sections (key, data) values (${s(key)}, ${q(data)}) on conflict (key) do nothing;`);
}
for (const p of seedProjects) {
  const tech = `array[${p.technologies.map(s).join(", ")}]::text[]`;
  lines.push(
    `insert into public.projects (slug, status, featured, sort_order, category, year, title, summary, description, objective, problem, role, contribution, process, results, technologies, live_url, repo_url, docs_url) values (` +
      [s(p.slug), s(p.status), String(p.featured), String(p.sortOrder), s(p.category), String(p.year), q(p.title), q(p.summary), q(p.description), q(p.objective), q(p.problem), q(p.role), q(p.contribution), q(p.process), q(p.results), tech, s(p.liveUrl), s(p.repoUrl), s(p.docsUrl)].join(", ") +
      `) on conflict (slug) do nothing;`,
  );
}
lines.push("commit;", "");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.info(`seed.sql written: ${Object.keys(seedContent).length} sections, ${seedProjects.length} projects`);
