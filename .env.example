# Copy to .env.local for local development. NEVER commit real values.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# --- Public (embedded in the browser bundle; not secret) -------------------------------
# Canonical site URL (no trailing slash). Used for SEO, sitemap, Open Graph and PDFs.
NEXT_PUBLIC_SITE_URL=https://ciupiustefan.com
# Supabase → Project Settings → API. The *publishable* key (sb_publishable_… or legacy "anon").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets ------------------------------------------------------------------
# Supabase *secret* key (sb_secret_… or legacy "service_role"). Bypasses RLS — server only.
SUPABASE_SECRET_KEY=
# Random string ≥ 32 chars used to pseudonymise IP addresses for rate limiting.
#   openssl rand -base64 48
IP_HASH_SALT=
# Random string ≥ 32 chars; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Days after which contact messages are deleted automatically (default 180).
CONTACT_RETENTION_DAYS=180

# --- Optional: e-mail notification for contact messages (Resend) --------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Site <noreply@ciupiustefan.com>"
CONTACT_FROM_EMAIL=
